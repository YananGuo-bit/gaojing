# 从 https://aistudio.google.com/app/apikey 免费获取
GEMINI_API_KEY=

# 在 Vercel 项目的 Storage 标签页添加 Postgres（Neon）后会自动生成，本地开发可留空
DATABASE_URL=

# 北京师范大学统一身份认证接入信息（向信息化办申请第三方接入后获得，均留空则登录功能自动隐藏）
BNU_SSO_CLIENT_ID=
BNU_SSO_CLIENT_SECRET=
BNU_SSO_AUTHORIZATION_URL=
BNU_SSO_TOKEN_URL=
BNU_SSO_USERINFO_URL=

# NextAuth 用于加密会话的随机字符串，任意生成一串即可，例如: openssl rand -base64 32
NEXTAUTH_SECRET=
